# Python / uv
venv/
.venv/
__pycache__/
*.pyc

# Build artifacts (PyInstaller, for the upcoming GUI app)
build/
dist/
*.spec.bak

# Secrets / local
.env
*.key

# Runtime logs (keep the folder via logs/.gitkeep, ignore the logs themselves)
logs/*.log
*.log

# Local data / misc
*.db
*.zip
output/
.DS_Store
.claude/

# Engine run-state, written next to the script when AUTOSYNC_STATE_DIR is unset
# (STATE_DIR defaults to $SCRIPT_DIR). Without these, running the CLI from the
# project directory makes autosync commit its own run state into itself.
last_sync.txt
last_status.txt

# Build metadata, written by scripts/stamp_version.py on every build.
# Output, not source: a checkout reads live git instead.
_build_info.json

# Build output (see build_app.sh: .noindex keeps Spotlight out)
build.noindex/
